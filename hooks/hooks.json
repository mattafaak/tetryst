{
  "description": "tetryst: claude-code-harness automation hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '__h() { /home/jwhit/.claude/plugins/cache/claude-code-harness-marketplace/claude-code-harness/4.11.3/bin/harness hook pre-tool \"$@\"; }; __h' _",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '__h() { /home/jwhit/.claude/plugins/cache/claude-code-harness-marketplace/claude-code-harness/4.11.3/bin/harness hook ask-user-question-normalize \"$@\"; }; __h' _",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '__h() { /home/jwhit/.claude/plugins/cache/claude-code-harness-marketplace/claude-code-harness/4.11.3/bin/harness hook permission \"$@\"; }; __h' _",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '__h() { /home/jwhit/.claude/plugins/cache/claude-code-harness-marketplace/claude-code-harness/4.11.3/bin/harness hook session-start \"$@\"; }; __h' _",
            "timeout": 15,
            "once": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '__h() { /home/jwhit/.claude/plugins/cache/claude-code-harness-marketplace/claude-code-harness/4.11.3/bin/harness hook post-tool \"$@\"; }; __h' _",
            "timeout": 10
          }
        ]
      }
    ],
    "Exit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c '__h() { /home/jwhit/.claude/plugins/cache/claude-code-harness-marketplace/claude-code-harness/4.11.3/bin/harness hook session-summary \"$@\"; }; __h' _",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
